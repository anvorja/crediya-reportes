# Copia este archivo a .env (no se versiona) y ajusta los valores. Nunca subas credenciales reales.
SERVER_PORT=8080
# JWKS de AUTENTICACION: las claves publicas con las que se verifican los tokens
AUTH_JWKS_URI=http://localhost:8081/.well-known/jwks.json
JWT_ISSUER=crediya-auth
JWT_AUDIENCE=crediya
# AWS: en local apunta a LocalStack; en AWS se dejan vacios (la tarea usa su rol de IAM)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
DYNAMODB_TABLE=crediya-reportes
SQS_APROBADAS_URL=http://localhost:4566/000000000000/crediya-solicitud-aprobada

# --- docker compose: ./scripts/init-env.sh genera un .env con estos nombres y valores aleatorios ---
AUTH_DB_USERNAME=crediya_auth
AUTH_DB_PASSWORD=cambia-esta-clave
AUTH_PORT=8081
REPORTES_PORT=8080
# Clave RSA PKCS#8 en base64 para firmar los JWT de AUTENTICACION: ./scripts/generate-jwt-key.sh
JWT_PRIVATE_KEY=
BOOTSTRAP_ADMIN_EMAIL=admin@crediya.local
BOOTSTRAP_ADMIN_PASSWORD=cambia-esta-clave-admin
BOOTSTRAP_ADMIN_DOCUMENTO=0000000001
